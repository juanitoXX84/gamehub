# Copia este archivo como ".env" (en esta misma carpeta) y completa los valores.
# Nunca subas el archivo .env a un repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True solo en desarrollo local.
DJANGO_DEBUG=True

# Hosts permitidos, separados por comas.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes del frontend React autorizados por CORS, separados por comas.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API KEY de RAWG (https://rawg.io/apidocs). Si se deja vacía, GameHub
# funcionará pero mostrará un aviso en lugar del catálogo de juegos.
RAWG_API_KEY=

# Opcionales
RAWG_CACHE_SECONDS=600
RAWG_TIMEOUT_SECONDS=10
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Web Service SOAP público de países (no requiere clave).
SOAP_COUNTRY_WSDL=http://webservices.oorsprong.org/websamples.countryinfo/CountryInfoService.wso?WSDL
SOAP_CACHE_SECONDS=3600
SOAP_TIMEOUT_SECONDS=15
