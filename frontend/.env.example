# Copia este archivo como ".env" (en la carpeta frontend).
# Solo variables públicas: todo lo que empieza con VITE_ termina en el navegador.
# NUNCA pongas aquí la API KEY de RAWG ni otras claves privadas.

# URL del servidor de Django (sin /api al final).
VITE_BASE_API_URL=http://127.0.0.1:8000

# Nombre de la clave de localStorage donde se guarda el token JWT.
VITE_LOCAL_STORAGE_ITEM_NAME=gamehub_token
